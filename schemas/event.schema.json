{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AndresZum04/gamestats/schemas/event.schema.json",
  "title": "GameStats event envelope",
  "description": "Common envelope shared by every event, schemaVersion 1.0. Game-specific keys live in data and are checked against configs/games/*.json.",
  "type": "object",
  "required": ["schemaVersion", "eventId", "timestamp", "gameId", "gameVersion", "matchId", "seq", "type", "data"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["1.0"]
    },
    "eventId": {
      "type": "string",
      "description": "UUID v4",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "description": "RFC 3339 in UTC with milliseconds",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$"
    },
    "gameId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "gameVersion": {
      "type": "string",
      "minLength": 1
    },
    "matchId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "playerId": {
      "description": "Required when the event type has playerRequired: true in the game config",
      "type": ["string", "null"],
      "minLength": 1
    },
    "type": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "consoleId": { "type": "string" },
        "sessionId": { "type": "string" }
      }
    },
    "data": {
      "type": "object"
    }
  }
}
