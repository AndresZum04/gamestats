<configuration>
  <!-- Una línea por mensaje: hora UTC, nivel, logger y texto. -->
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z',UTC} %-5level %logger{20} - %msg%n</pattern>
    </encoder>
  </appender>

  <logger name="org.http4s" level="WARN"/>

  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
